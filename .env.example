# Static data aggregation
GITHUB_TOKEN=
ITEM_LOOKBACK_DAYS=365
GITHUB_TOPICS=municipio-se,getmunicipio
GITHUB_PROJECT_OWNER=helsingborg-stad
GITHUB_PROJECT_NUMBER=7
GITHUB_RELEASE_REPOSITORY=municipio-se/municipio-deployment

# GitHub-first editing on Vercel
# Set GITHUB_APP_URL to the frontend origin that should receive the post-login redirect.
GITHUB_APP_URL=http://localhost:3000
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_SESSION_SECRET=
GITHUB_OAUTH_SCOPES=read:user repo project
